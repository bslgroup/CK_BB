sbatch --job-name=namd-job --nodes=$NUMHOSTS --ntasks=$TOTALRANKS --time=$TIME --partition=$QUEUE << ENDINPUT
#!/bin/bash

cd $RUNDIR

module load namd/2.14

echo ibrun namd2 +ppn 6 +pemap 2-12:2,16-26:2,30-40:2,44-54:2,3-13:2,17-27:2,31-41:2,45-55:2 +commap 0,14,28,42,1,15,29,43 $CONFFILE $REPARGS

