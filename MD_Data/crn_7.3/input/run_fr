set QUEUE = normal
if ( $NUMHOSTS > 512 ) set QUEUE = large
set TIME = 12:00:00

if ( $# ) then
  if ( $1 == normal ) then
    shift
  else if ( $1 == test ) then
    set TIME = 00:30:00
    set QUEUE = normal
    if ( $NUMHOSTS < 41 ) set QUEUE = development
    if ( $NUMHOSTS > 512 ) set QUEUE = large
    shift
  else if ( $1 == short ) then
    set TIME = 00:30:00
    set QUEUE = normal
    if ( $NUMHOSTS > 512 ) set QUEUE = large
    shift
  endif
endif

if ( $# && $1 =~ --account=* ) then
  set QUEUE = "$QUEUE $1"
  shift
endif

set REPLICAS = 1
set REPARGS = ""

while ( $# )
  if ( "$1" == "+replicas" || "$1" == "+partitions" ) then
    set REPLICAS = $2
  endif
  set REPARGS = "$REPARGS $1"
  shift
end

if ( $REPLICAS == $NUMHOSTS ) then
  set RANKSPERHOST = 1
endif
if ( $REPLICAS == $NUMHOSTS * 4 ) then
  set RANKSPERHOST = 4
endif
if ( $REPLICAS == $NUMHOSTS * 6 ) then
  set RANKSPERHOST = 6
endif

@ TOTALRANKS = $NUMHOSTS * $RANKSPERHOST

if ( $TOTALRANKS % $REPLICAS ) then
  echo "replicas must evenly divide total processes"
  exit -1
endif

if ( ! -f $CONFFILE ) then
  echo "NAMD input file $CONFFILE does not exist!"
  exit -1
endif

if ( -f $LOGFILE ) then
  echo "NAMD input file $LOGFILE already exists!"
  exit -1
endif

