#!/bin/csh

if ( $HOST !~ *frontera* ) then
  echo "This script must be run on the Frontera head nodes."
  exit -1
endif

set CORESPERHOST = 56

if ( $# < 3 ) then
  echo "This script requires three arguments:"
  echo "  NAMD input file"
  echo "  NAMD log file"
  echo "  number of nodes (number of cores / $CORESPERHOST)"
  echo "  processes per node (defaults to 4, other options are 6, 2, and 1)"
  #echo '  use hyperthreads (defaults to "noht", other option is "ht")'
  echo '  queue (defaults to "normal", other options are "test" and "short")'
  echo '  --account=XXXXX (optional)'
  echo "  replica or other args (optional)"
  exit -1
endif

set CONFFILE = $1
shift
set LOGFILE = $1
shift
set NUMHOSTS = $1
shift

set RANKSPERHOST = 8

if ( $# && $1 !~ *[a-z]* ) then
  set RANKSPERHOST = $1
  shift
endif

